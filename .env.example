# Hermes: configure ao menos um provedor de modelo antes do primeiro uso.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram (opcional durante o desenvolvimento).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Imagem e identidade do container Hermes.
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=10000
HERMES_GID=10000

# API MCP interna. A porta não é publicada no host.
MCP_HOST=0.0.0.0
MCP_PORT=8000
JOB_HUNTER_WORKSPACE=/app/workspace

