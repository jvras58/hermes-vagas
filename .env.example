# Provedor principal: NVIDIA Build / NIM.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Provedor alternativo futuro. Não é usado enquanto não for adicionado à
# fallback_providers em config/hermes/config.yaml.
# GROQ_API_KEY=

# Busca de posts públicos do LinkedIn via Apify HarvestAPI.
APIFY_TOKEN=
APIFY_LINKEDIN_POSTS_ACTOR=harvestapi/linkedin-post-search
APIFY_MAX_TOTAL_CHARGE_USD=0.50
APIFY_TIMEOUT_SECONDS=240

# Telegram (opcional durante o desenvolvimento).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Imagem e identidade do container Hermes.
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=10000
HERMES_GID=10000

# Autenticação do dashboard Hermes.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# API MCP interna. A porta não é publicada no host.
MCP_HOST=0.0.0.0
MCP_PORT=8000
JOB_HUNTER_WORKSPACE=/app/workspace
